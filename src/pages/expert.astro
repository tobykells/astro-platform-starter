---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Experts - K-Insights">
    <div class="min-h-screen py-8 sm:py-12">
        <div class="max-w-4xl mx-auto">
            <div class="text-center mb-12">
                <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-6" style="font-family: 'Gowun Batang', serif; color: #221d1e;">
                    Join the network.
                </h1>
                <p class="text-lg sm:text-xl font-roboto text-gray-800 max-w-3xl mx-auto">
                    Consult on your expertise, sign up to be contacted for paid consultations on whatever you know best.
                </p>
            </div>
            
            <div class="bg-white border rounded-lg shadow-lg p-6 sm:p-8" style="border-color: #e3f3eb;">
                <form name="expert-signup" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="space-y-6">
                    <input type="hidden" name="form-name" value="expert-signup" />
                    <div class="hidden">
                        <label>
                            Don't fill this out if you're human: <input name="bot-field" />
                        </label>
                    </div>
                    
                    <div>
                        <label for="email" class="block text-sm font-bold text-gray-700 mb-2" style="font-family: 'Gowun Batang', serif;">
                            Email Address
                        </label>
                        <input 
                            type="email" 
                            id="email" 
                            name="email" 
                            required 
                            class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" 
                            style="border-color: #e3f3eb;"
                        />
                    </div>
                    
                    <div>
                        <label for="phone" class="block text-sm font-bold text-gray-700 mb-2" style="font-family: 'Gowun Batang', serif;">
                            Phone Number
                        </label>
                        <input 
                            type="tel" 
                            id="phone" 
                            name="phone" 
                            class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" 
                            style="border-color: #e3f3eb;"
                        />
                    </div>
                    
                    <div>
                        <label for="industry" class="block text-sm font-bold text-gray-700 mb-2" style="font-family: 'Gowun Batang', serif;">
                            Industry/Area of Expertise
                        </label>
                        <input 
                            type="text" 
                            id="industry" 
                            name="industry" 
                            required
                            class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent font-roboto text-sm" 
                            style="border-color: #e3f3eb;"
                            placeholder="e.g., Healthcare, Technology, Finance"
                        />
                    </div>
                    
                    <div>
                        <label for="brief" class="block text-sm font-bold text-gray-700 mb-2" style="font-family: 'Gowun Batang', serif;">
                            Brief Description of Your Expertise
                        </label>
                        <textarea 
                            id="brief" 
                            name="brief" 
                            rows="5" 
                            required
                            class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent font-roboto text-sm" 
                            style="border-color: #e3f3eb;"
                            placeholder="Please describe your areas of expertise, experience, and what kind of consultations you can provide..."
                        ></textarea>
                    </div>
                    
                    <button 
                        type="submit" 
                        class="w-full bg-primary text-white font-bold py-3 px-6 rounded-lg hover:bg-primary/85 transition-colors" 
                        style="font-family: 'Gowun Batang', serif;"
                    >
                        Join the Network
                    </button>
                </form>
                
                <div class="mt-8 pt-6 border-t" style="border-color: #e3f3eb;">
                    <p class="text-center font-roboto text-gray-800">
                        Or contact us directly at 
                        <a href="mailto:experts@k-insights.co.uk" class="font-bold text-blue-600 hover:text-blue-800">
                            experts@k-insights.co.uk
                        </a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</Layout>