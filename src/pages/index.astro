---
import Layout from '../layouts/Layout.astro';
import { translations } from '../utils/translations';

const currentLang = Astro.cookies.get('language')?.value || 'en';
const t = translations[currentLang as keyof typeof translations] || translations.en;
---

<Layout title="K-Insights - Expert Network">
    <div class="max-w-4xl">
        <h1 class="mb-8" style="font-family: 'Gowun Batang', serif; color: #221d1e;">{t.welcomeTitle}</h1>
        
        <div class="bg-white border rounded-lg shadow-lg p-6 sm:p-8 mb-8" style="border-color: #e3f3eb;">
            <h2 class="text-xl sm:text-2xl font-semibold mb-6" style="font-family: 'Gowun Batang', serif; color: #221d1e;">{t.whoWeAre}</h2>
            
            <div class="text-base sm:text-xl leading-relaxed font-roboto">
                <p class="mb-6 text-gray-800 leading-relaxed">{t.whoWeAreText1}</p>
                
                <p class="mb-6 text-gray-800 leading-relaxed">{t.whoWeAreText2}</p>
                
                <h3 class="text-xl sm:text-2xl font-semibold mb-4" style="font-family: 'Gowun Batang', serif; color: #221d1e;">{t.how}</h3>
                
                <p class="mb-6 text-gray-800 leading-relaxed">{t.howText}</p>
            </div>
            
            <h2 class="text-xl sm:text-2xl font-semibold mb-6 mt-8" style="font-family: 'Gowun Batang', serif; color: #221d1e;">{t.getInTouch}</h2>
            
            <p class="mb-8 text-gray-800 leading-relaxed font-roboto">{t.getInTouchText}</p>
            
            <div class="mt-8 flex flex-col sm:flex-row gap-4">
                <a href="/client" class="inline-flex items-center justify-center px-6 py-3 font-semibold text-white rounded-lg transition-colors" style="background-color: #221d1e; font-family: 'Gowun Batang', serif;"
                   onmouseover="this.style.backgroundColor='#191619'"
                   onmouseout="this.style.backgroundColor='#221d1e'">
                    {t.startProject}
                </a>
                <a href="/expert" class="inline-flex items-center justify-center px-6 py-3 font-semibold border-2 rounded-lg transition-colors" style="color: #221d1e; border-color: #221d1e; font-family: 'Gowun Batang', serif;"
                   onmouseover="this.style.backgroundColor='#221d1e'; this.style.color='white'"
                   onmouseout="this.style.backgroundColor='transparent'; this.style.color='#221d1e'">
                    {t.joinNetwork}
                </a>
            </div>
        </div>
    </div>
</Layout>
