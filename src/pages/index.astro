---
import Layout from '../layouts/Layout.astro';
---

<Layout title="K-Insights - Business Intelligence Consultancy">
    <div class="max-w-4xl mx-auto">
        <h1 class="mb-10 text-4xl font-bold text-center">K-Insights</h1>
        
        <div class="bg-gray-800 p-8 rounded-lg shadow-lg mb-10">
            <h2 class="text-2xl font-semibold mb-6 text-center">Who we are</h2>
            
            <p class="text-lg mb-6 leading-relaxed font-montserrat">
                An Astro website can go way beyond static pages - on the right platform.
            </p>
            
            <p class="text-lg mb-8 leading-relaxed font-montserrat">
                Frequently reserved for consultancies and private equities, it is our mission to democratise business insights; giving companies of all types direct access to market intelligence.
            </p>
            
            <h2 class="text-2xl font-semibold mb-6 text-center">How?</h2>
            
            <p class="text-lg mb-8 leading-relaxed font-montserrat">
                We arrange consultations for you to connect directly with industry leaders, potential suppliers, regulators, or anyone else relevant to your strategic goals; strictly on a no commitment needed, pay as you go basis.
            </p>
            
            <div class="text-center">
                <a href="#contact" class="btn btn-lg bg-blue-600 hover:bg-blue-700 text-white px-8 py-3 rounded-lg inline-block transition-colors">
                    Get in touch
                </a>
            </div>
        </div>
    </div>
</Layout>
