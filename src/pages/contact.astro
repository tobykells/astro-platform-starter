---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact - K-Insights">
    <div class="min-h-screen py-8 sm:py-12">
        <div class="max-w-4xl mx-auto">
            <div class="text-center mb-12">
                <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-6" style="font-family: 'Gowun Batang', serif; color: #221d1e;">
                    Get in touch
                </h1>
            </div>
            
            <div class="bg-white border rounded-lg shadow-lg p-6 sm:p-8" style="border-color: #e3f3eb;">
                <div class="text-center space-y-6">
                    <div>
                        <h2 class="text-xl sm:text-2xl font-bold mb-4 font-roboto text-gray-800">
                            Contact Information
                        </h2>
                        <p class="text-lg font-roboto text-gray-800 mb-4">
                            We'd love to hear from you. Reach out to us for any inquiries or questions.
                        </p>
                    </div>
                    
                    <div class="space-y-4">
                        <div class="p-4 bg-gray-50 rounded-lg">
                            <h3 class="font-bold text-gray-700 mb-2" style="font-family: 'Gowun Batang', serif;">
                                General Inquiries
                            </h3>
                            <a href="mailto:hello@k-insights.co.uk" class="text-lg font-bold text-blue-600 hover:text-blue-800 transition-colors">
                                hello@k-insights.co.uk
                            </a>
                        </div>
                        
                        <div class="grid md:grid-cols-2 gap-4">
                            <div class="p-4 bg-gray-50 rounded-lg">
                                <h3 class="font-bold text-gray-700 mb-2" style="font-family: 'Gowun Batang', serif;">
                                    For Clients
                                </h3>
                                <a href="mailto:clients@k-insights.co.uk" class="font-bold text-blue-600 hover:text-blue-800 transition-colors">
                                    clients@k-insights.co.uk
                                </a>
                                <p class="text-sm font-roboto text-gray-600 mt-1">
                                    Project inquiries and consultations
                                </p>
                            </div>
                            
                            <div class="p-4 bg-gray-50 rounded-lg">
                                <h3 class="font-bold text-gray-700 mb-2" style="font-family: 'Gowun Batang', serif;">
                                    For Experts
                                </h3>
                                <a href="mailto:experts@k-insights.co.uk" class="font-bold text-blue-600 hover:text-blue-800 transition-colors">
                                    experts@k-insights.co.uk
                                </a>
                                <p class="text-sm font-roboto text-gray-600 mt-1">
                                    Join our network of consultants
                                </p>
                            </div>
                        </div>
                    </div>
                    
                </div>
            </div>
        </div>
    </div>
</Layout>